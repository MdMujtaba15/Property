        df2["TEXT1"] = df2["TEXT1"].str.lower()
        df2.reset_index(inplace=True)

        df2["TEXT1"] = df2["TEXT1"].apply(
            lambda txt: self.remove_string_special_characters(txt)
        )

        # spaCy lemmatization
        total = len(df2)
        progress = 0

        try:
            spac_lemm = spacy.load("en_core_web_sm", disable=["parser", "ner"])
        except:
            en_core_web_sm.load()
            spac_lemm = spacy.load("en_core_web_sm", disable=["parser", "ner"])
        spac_lem_docs = []
        self.logger.log("Please wait for few mins...")
        for doc in df2["TEXT1"]:

            try:
                temp = spac_lemm(doc)
                spac_lem_docs.append(" ".join([token.lemma_ for token in temp]))
            except:
                spac_lem_docs.append(" ")

            progress += 1

        df2["SPAC"] = spac_lem_docs

        keywords = []
        keyphrases = None
        # the given file must have each keyword on a separate line, all lowercase
        with open(os.path.join(self.sas_scripts_path, "Keywords_lem.txt")) as file:
            keywords = file.read()

        keywords = ast.literal_eval(keywords)

        keyword_regex = {key: "" for key in keywords.keys()}
        for key in keyword_regex.keys():
            keyword_regex[key] = "|".join(keywords[key])

        # detects for presence of keywords
        for key in keyword_regex.keys():
            keyword_regex[key] = re.compile(keyword_regex[key])

        # create structure for storing keyword detections
        detections = {key: [] for key in keyword_regex.keys()}
        # for each document, check all of the regex
        for doc in df2["SPAC"]:
            for key, regex in keyword_regex.items():
                if re.findall(
                    regex, doc
                ):  # append 1 if regex finds a match, else append 0
                    detections[key].append(1)
                else:
                    detections[key].append(0)

        detections = pd.DataFrame(detections)
        detections["SVC_REQ_NR"] = df2["SVC_REQ_NR"]

        def prepare_pa_regex(filename):  # this creates the regex for pa
            file = open(filename, "r")
            regex = file.readlines()
            file.close()  # Remove new line characters from expression
            for i in range(len(regex)):
                regex[i] = regex[i].strip()

            ret = "".join(regex)  # join the parts together
            ret = ret[
                1:-1
            ]  # remove first and last characters, left over artifact from SAS processing
            ret = ret.replace("|home", "")
            ret = ret.replace("|pa", "")
            ret = (
                r"// ave | st | dr | rd |erie pa|address|pennsylvania|pittsburgh|philadelphia|pa st police|state pa|pa state police|pa driver license|"
                + ret
                + r"/g"
            )
            return re.compile(ret)

        # for every document, for each occurence of "pa",
        # run through more regex to determine if Pennsylvania or public adjuster

        matches = []

        for doc, i in zip(df2["SPAC"], range(len(df2))):
            if (
                detections["public_adjuster"].loc[i] == 1
            ):  # only check documents with "pa" or "public adjuster"
                match_list = re.findall(
                    "((\w+\W+){0,10}pa (\w+\W+){0,10})", df2["SPAC"].loc[i]
                )  # get 10 words around "pa"

                for element in match_list:
                    matches.append((i, element[0]))

        pa_regex = prepare_pa_regex(os.path.join(self.sas_scripts_path, "pa_regex.txt"))
        public_ad_regex = re.compile(
            "public adjuster|pa sent|pa present|the pa (?! state)|call pa |email pa |speak to pa |advise pa |with pa |from pa "
        )

        # for each occurence, check against Pennsylvania and public adjuster regex to determine which it is
        # if unable to determine, assume it means public adjuster
        for match in matches:
            i = match[0]
            doc = match[1]
            if re.findall(pa_regex, doc):
                detections["public_adjuster"].loc[i] = 0
            elif re.findall(public_ad_regex, doc):
