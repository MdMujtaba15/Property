            Input: string
            Output: string
        """

        # Tokenize: Split the sentence into words
        word_list = nltk.word_tokenize(text)

        # Lemmatize list of words and join
        lemmatized_output = " ".join([lemmatizer.lemmatize(w) for w in word_list])

